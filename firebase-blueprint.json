{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role-based access control",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "User UID" },
        "email": { "type": "string", "format": "email", "description": "User email address" },
        "displayName": { "type": "string", "maxLength": 100, "description": "Display name" },
        "role": { "type": "string", "enum": ["owner", "admin", "manager", "cashier", "warehouse", "finance"], "description": "User role in store" },
        "isActive": { "type": "boolean", "description": "Whether user account is active" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "description": "Update timestamp" }
      },
      "required": ["id", "email", "displayName", "role", "isActive"]
    },
    "Product": {
      "title": "Product",
      "description": "Building material or retail store product inventory record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sku": { "type": "string", "maxLength": 50 },
        "barcode": { "type": "string", "maxLength": 50 },
        "name": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 1000 },
        "categoryId": { "type": "string" },
        "categoryName": { "type": "string" },
        "unit": { "type": "string", "maxLength": 20 },
        "unitConversions": { "type": "string", "description": "JSON serializable conversion definitions" },
        "purchasePrice": { "type": "number" },
        "sellingPrice": { "type": "number" },
        "wholesalePrice": { "type": "number" },
        "stock": { "type": "number" },
        "minStock": { "type": "number" },
        "warehouseId": { "type": "string" },
        "supplierId": { "type": "string" },
        "imageUrl": { "type": "string" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "sku", "name", "unit", "purchasePrice", "sellingPrice", "stock", "isActive"]
    },
    "Sale": {
      "title": "Sale",
      "description": "POS sale transaction document",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "invoiceNumber": { "type": "string", "maxLength": 50 },
        "date": { "type": "string" },
        "cashierId": { "type": "string" },
        "cashierName": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "tax": { "type": "number" },
        "total": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "paymentStatus": { "type": "string", "enum": ["paid", "credit", "partial"] },
        "paidAmount": { "type": "number" },
        "changeAmount": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "invoiceNumber", "total", "paymentMethod", "paymentStatus"]
    },
    "Purchase": {
      "title": "Purchase",
      "description": "Supplier purchase invoice and procurement record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "invoiceNumber": { "type": "string", "maxLength": 50 },
        "supplierId": { "type": "string" },
        "supplierName": { "type": "string" },
        "totalAmount": { "type": "number" },
        "paidAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["ordered", "received", "cancelled"] },
        "paymentStatus": { "type": "string", "enum": ["paid", "credit", "partial"] },
        "dueDate": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "invoiceNumber", "supplierId", "totalAmount", "status"]
    },
    "StockMovement": {
      "title": "StockMovement",
      "description": "Stock mutation audit log entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "type": { "type": "string", "enum": ["in", "out", "adjustment", "transfer", "opname", "damage", "sale_return"] },
        "quantity": { "type": "number" },
        "unit": { "type": "string" },
        "previousStock": { "type": "number" },
        "currentStock": { "type": "number" },
        "referenceId": { "type": "string" },
        "referenceType": { "type": "string" },
        "reason": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "productId", "type", "quantity", "previousStock", "currentStock"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Store customer and debtor record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 30 },
        "creditLimit": { "type": "number" },
        "currentDebt": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "Material distributor and vendor record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 30 },
        "currentDebt": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "CashSession": {
      "title": "CashSession",
      "description": "Cashier POS shift cash session",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "cashierId": { "type": "string" },
        "cashierName": { "type": "string" },
        "startingCash": { "type": "number" },
        "actualCash": { "type": "number" },
        "status": { "type": "string", "enum": ["open", "closed"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "cashierId", "startingCash", "status"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Store operational expense record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "category": { "type": "string" },
        "amount": { "type": "number" },
        "description": { "type": "string" },
        "date": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "category", "amount", "description"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and RBAC permissions"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Store inventory products catalog"
    },
    "/sales/{saleId}": {
      "schema": "Sale",
      "description": "POS sales transactions"
    },
    "/purchases/{purchaseId}": {
      "schema": "Purchase",
      "description": "Supplier purchases and inventory intakes"
    },
    "/stockMovements/{movementId}": {
      "schema": "StockMovement",
      "description": "Complete audit trail of inventory mutations"
    },
    "/customers/{customerId}": {
      "schema": "Customer",
      "description": "Customer profiles and credit tracking"
    },
    "/suppliers/{supplierId}": {
      "schema": "Supplier",
      "description": "Supplier and vendor details"
    },
    "/cashSessions/{sessionId}": {
      "schema": "CashSession",
      "description": "Cashier shift register sessions"
    },
    "/expenses/{expenseId}": {
      "schema": "Expense",
      "description": "Operational expenses and disbursements"
    }
  }
}
